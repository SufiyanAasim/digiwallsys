# Vercel (web) -- environment variables to set on the Vercel project, in its
# dashboard's Settings -> Environment Variables. Expo only inlines variables
# prefixed EXPO_PUBLIC_ into the web bundle at build time (src/mobile), so
# only those belong here; nothing above ever reaches the browser.
#
# Vercel's Root Directory must be set to src/mobile, and the build command to
# `npm run build:web` (output directory `dist-web`) -- see
# docs/deployment/Deployment.md for why vercel.json is committed at both the
# repo root and inside src/mobile.

# Replace with the HTTPS URL of the API service you deploy.
EXPO_PUBLIC_API_URL=https://api.example.com

# Only read by NotificationsScreen.js to register a push token; harmless to
# leave unset for a web-only deployment (push registration already requires
# a physical device and fails before this is checked).
EXPO_PUBLIC_EAS_PROJECT_ID=

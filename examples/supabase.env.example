# Supabase (PostgreSQL) -- variables the API needs to talk to a Supabase-hosted
# database. This is a subset of .env.example; see that file for what every
# variable does. Nothing here is a real credential -- copy it, then fill in
# the values from your own Supabase project's Settings -> Database page.

# Supabase gives three connection strings on that page. Use the DIRECT
# connection (port 5432) or the SESSION pooler, not the TRANSACTION pooler
# (port 6543): the API holds its own long-lived pg.Pool (src/backend/db.js)
# and issues plain parameterized queries across that pool's lifetime, and
# PgBouncer's transaction mode does not reliably support session state across
# pooled connections, which api.js's ledger transactions and idempotency
# locks rely on. The transaction pooler exists for serverless/edge functions
# that open one connection per request, not a persistent server process
# like this one.
#
# Direct connection (works when your network reaches Supabase's DB host directly):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[project-ref].supabase.co:5432/postgres
#
# Session pooler (IPv4-only networks, e.g. some CI runners and free-tier hosts):
DATABASE_URL=postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres

# Supabase requires TLS.
DATABASE_SSL=true

# Supabase's own connection limit is modest on free/small tiers; keep this
# comfortably under it if the API and any other service share the project.
DATABASE_POOL_SIZE=10

# Only needed to run the PostgreSQL integration suite (docs/development/Testing.md)
# against Supabase directly -- most people run that suite against local/CI
# Postgres instead. Must end in _test if set.
TEST_DATABASE_URL=

# Schema setup: Supabase does not run a custom docker-entrypoint-style init
# script. Apply config/database.sql once via the SQL Editor (or `psql
# "$DATABASE_URL" -f config/database.sql`) against a fresh project, or apply
# config/migrations/*.sql in order against an existing one -- see
# docs/development/Database.md.

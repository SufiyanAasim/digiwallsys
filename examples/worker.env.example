# Use this template for a dedicated background worker service.
NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=true
DATABASE_POOL_SIZE=10
JWT_SECRET=replace-with-a-long-random-secret
MAX_TRANSFER_AMOUNT=10000
DAILY_TRANSFER_AMOUNT=25000
HOURLY_TRANSFER_COUNT=20
# Leave email delivery disabled until a real adapter and bearer token are
# configured. Enabling it without both values intentionally stops a production
# worker rather than silently discarding verification and recovery messages.
EMAIL_WEBHOOK_URL=
EMAIL_DELIVERY_TOKEN=
ENABLE_SCHEDULER=true
ENABLE_PUSH_WORKER=true
ENABLE_EMAIL_WORKER=false

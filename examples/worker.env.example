# Use this template for a dedicated background worker service.
NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=true
DATABASE_POOL_SIZE=10
JWT_SECRET=replace-with-a-long-random-secret
MAX_TRANSFER_AMOUNT=10000
DAILY_TRANSFER_AMOUNT=25000
HOURLY_TRANSFER_COUNT=20
EMAIL_WEBHOOK_URL=https://mail-provider.example.com/send
EMAIL_DELIVERY_TOKEN=replace-with-provider-token
ENABLE_SCHEDULER=true
ENABLE_PUSH_WORKER=true
ENABLE_EMAIL_WORKER=true

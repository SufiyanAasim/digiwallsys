# Render (API) -- environment variables to set on the Render web service, in
# its dashboard's Environment tab (Render does not read a .env file from the
# repo). This is .env.example's full backend set with production-appropriate
# values; see .env.example for what each one does.
#
# Render sets its own PORT automatically and the API already reads
# process.env.PORT (src/backend/server.js) -- do not set PORT here yourself.

NODE_ENV=production

# From examples/supabase.env.example, or your own PostgreSQL host.
DATABASE_URL=postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_SSL=true
DATABASE_POOL_SIZE=10

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Canonical Vercel web app plus any additional permitted origins. The API
# always includes PUBLIC_WEB_ORIGIN in production; CORS_ORIGIN extends that
# list with comma-separated preview or administrative frontends.
PUBLIC_WEB_ORIGIN=https://digiwallsys.vercel.app
CORS_ORIGIN=https://digiwallsys.vercel.app

# Render terminates TLS in front of the service and forwards over HTTP, so
# the API sits behind exactly one proxy hop.
TRUST_PROXY=1
GLOBAL_RATE_LIMIT=120

MAX_TRANSFER_AMOUNT=10000
DAILY_TRANSFER_AMOUNT=25000
HOURLY_TRANSFER_COUNT=20

FUNDING_PROVIDER=sandbox
FUNDING_PROVIDER_CHECKOUT_URL=
# Generate the same way as JWT_SECRET; keep it different from JWT_SECRET.
FUNDING_WEBHOOK_SECRET=replace-with-provider-webhook-secret

# Delivery secrets belong on the separate worker service, using
# examples/worker.env.example, rather than on the public API service.
RUN_INLINE_WORKERS=false

# Optional one-time Render Shell values for `npm run demo:seed`. Remove every
# DEMO_* variable immediately after provisioning.
DEMO_USER_1_EMAIL=user1@digiwallsys.com
DEMO_USER_1_PASSWORD=
DEMO_USER_1_NAME=digiwallsys User 1
DEMO_USER_2_EMAIL=user2@digiwallsys.com
DEMO_USER_2_PASSWORD=
DEMO_USER_2_NAME=digiwallsys User 2
DEMO_USER_OPENING_BALANCE=1000

# Render build/start commands (set once, in the service's Settings, not here):
#   Build:  npm ci --workspace @digiwallsys/api
#   Start:  npm run start:api
# Or point Render at the root Dockerfile instead of a native Node runtime --
# either works. Create a second background worker service with:
#   Start:  npm run start:worker

{
  "expo": {
    "name": "digiwallsys",
    "slug": "digiwallsys",
    "scheme": "digiwallsys",
    "version": "1.8.0",
    "plugins": [
      "./plugins/withAndroidMonorepoRoot",
      "expo-secure-store",
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon-app.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B0A10",
          "dark": {
            "image": "./assets/icon-app.png",
            "backgroundColor": "#0B0A10"
          }
        }
      ]
    ],
    "orientation": "portrait",
    "icon": "./assets/icon-app.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.sufiyanaasim.digiwallsys",
      "buildNumber": "4",
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to unlock your digiwallsys session.",
        "NSCameraUsageDescription": "Scan digiwallsys payment QR codes."
      }
    },
    "android": {
      "package": "com.sufiyanaasim.digiwallsys",
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-adaptive-foreground.png",
        "backgroundColor": "#0B0A10"
      },
      "permissions": [
        "CAMERA",
        "USE_BIOMETRIC"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    }
  }
}

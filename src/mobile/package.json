{
  "name": "@digiwallsys/mobile",
  "author": "Mohammad Sufiyan Aasim",
  "license": "MIT",
  "version": "1.9.0",
  "main": "index.js",
  "scripts": {
    "start": "node scripts/run-package-bin.js expo start",
    "android": "node scripts/run-package-bin.js expo start --android",
    "ios": "node scripts/run-package-bin.js expo start --ios",
    "web": "node scripts/run-package-bin.js expo start --web",
    "lint": "node scripts/run-package-bin.js eslint App.js api.js index.js motion.js navigation.js session.js theme.js ThemeContext.js utils.js components screens",
    "test": "node --test ../../tests/mobile/*.test.js",
    "build": "node scripts/run-package-bin.js expo export --platform android --output-dir dist",
    "build:web": "node scripts/run-package-bin.js expo export --platform web --output-dir dist-web",
    "build:ios:bundle": "node scripts/run-package-bin.js expo export --platform ios --output-dir dist-ios",
    "build:android:apk": "npx --yes eas-cli@21.4.0 build --platform android --profile preview",
    "build:android:aab": "npx --yes eas-cli@21.4.0 build --platform android --profile production",
    "build:ios:ipa": "npx --yes eas-cli@21.4.0 build --platform ios --profile production"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-native-picker/picker": "2.11.4",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "@react-navigation/stack": "^7.12.0",
    "axios": "^1.20.0",
    "expo": "~57.0.26",
    "expo-camera": "~57.0.6",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.1",
    "expo-linear-gradient": "~57.0.2",
    "expo-local-authentication": "~57.0.3",
    "expo-notifications": "~57.0.11",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.87.1",
    "react-native-gesture-handler": "~2.33.0",
    "react-native-qrcode-svg": "^6.3.26",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.28.0",
    "react-native-svg": "15.15.5",
    "react-native-web": "^0.21.3"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0"
  },
  "private": true
}

**/dist-ios/
dist-web/
**/dist-web/
web-build/
**/web-build/
coverage/
**/coverage/

src/mobile/.git/
src/mobile/android/
src/mobile/ios/
src/mobile/.eas/
**/.kotlin/

artifacts/

*.log

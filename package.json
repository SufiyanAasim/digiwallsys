{
  "name": "digiwallsys",
  "version": "1.9.0",
  "private": true,
  "description": "A full-stack digital wallet demo with an Expo mobile client and Express API.",
  "author": "Mohammad Sufiyan Aasim",
  "license": "MIT",
  "workspaces": [
    "src/backend",
    "src/mobile"
  ],
  "scripts": {
    "start:api": "npm run start --workspace @digiwallsys/api",
    "start:worker": "npm run start:worker --workspace @digiwallsys/api",
    "demo:seed": "npm run demo:seed --workspace @digiwallsys/api",
    "start:mobile": "npm run start --workspace @digiwallsys/mobile",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspace @digiwallsys/mobile",
    "build:web": "npm run build:web --workspace @digiwallsys/mobile",
    "build:ios:bundle": "npm run build:ios:bundle --workspace @digiwallsys/mobile",
    "build:android:apk": "npm run build:android:apk --workspace @digiwallsys/mobile",
    "build:android:aab": "npm run build:android:aab --workspace @digiwallsys/mobile",
    "build:ios:ipa": "npm run build:ios:ipa --workspace @digiwallsys/mobile",
    "brand:generate": "node scripts/generate-brand-assets.js",
    "check:name": "node scripts/check-name.js",
    "check:docs": "node scripts/check-doc-links.js && node scripts/check-api-docs.js",
    "check:expo": "node src/mobile/scripts/run-package-bin.js expo-doctor",
    "verify": "npm run check:name && npm run check:docs && npm run check:expo && npm run lint && npm test"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "overrides": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "flatted": "3.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-svg": "15.15.4",
    "tar": "7.5.22",
    "xcode@3.0.1": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "expo-doctor": "1.20.1",
    "pngjs": "^7.0.0",
    "react": "19.2.8"
  }
}

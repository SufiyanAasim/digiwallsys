# API
# Leave unset for local development. Setting this to "production" withholds
# verification/reset tokens from API responses; the dedicated production worker
# requires both email delivery variables -- see docs/development/Authentication.md.
NODE_ENV=
PORT=5000
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGIN=http://localhost:8081,http://localhost:19006
PUBLIC_WEB_ORIGIN=https://digiwallsys.vercel.app
TRUST_PROXY=0
GLOBAL_RATE_LIMIT=120
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# One-time administrator bootstrap. Set these only for `npm run admin:seed`,
# run the command from a trusted environment, then unset them immediately.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=System Administrator

# PostgreSQL
DATABASE_URL=postgresql://digiwallsys:digiwallsys@localhost:5432/digiwallsys
DATABASE_SSL=false
DATABASE_POOL_SIZE=10

# Set to a database ending in _test to run the PostgreSQL integration suite
# (migrations, ledger balancing, reconciliation, concurrent-overdraft checks —
# see docs/development/Testing.md). Left unset, that suite is skipped.
TEST_DATABASE_URL=

# Risk controls
MAX_TRANSFER_AMOUNT=10000
DAILY_TRANSFER_AMOUNT=25000
HOURLY_TRANSFER_COUNT=20

# Funding provider adapter
FUNDING_PROVIDER=sandbox
FUNDING_PROVIDER_CHECKOUT_URL=
FUNDING_WEBHOOK_SECRET=replace-with-provider-webhook-secret

# Email delivery adapter (development logs masked recipients when omitted)
EMAIL_WEBHOOK_URL=
EMAIL_DELIVERY_TOKEN=

# Background workers
ENABLE_SCHEDULER=true
ENABLE_PUSH_WORKER=true
ENABLE_EMAIL_WORKER=true
RUN_INLINE_WORKERS=true

# Optional: base URL scripts/simulate-funding-webhook.js posts the signed
# sandbox webhook to. Defaults to http://localhost:$PORT, so this is only
# needed when the API isn't running on the same host/port.
API_BASE_URL=

# Expo (production API is the safe default for physical-device testing; switch
# to a LAN URL only while the local API is intentionally running)
EXPO_PUBLIC_API_URL=https://digiwallsys-api.onrender.com
EXPO_PUBLIC_EAS_PROJECT_ID=7c79c661-f3ea-4c5d-b207-77b8de410ba1
